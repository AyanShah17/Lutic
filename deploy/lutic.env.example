# Generate a private copy with bash deploy/lutic.sh prepare.
POSTGRES_USER=lutic
POSTGRES_DB=lutic
POSTGRES_PASSWORD=
DATABASE_URL=
POSTGRES_PORT=5432
LUTIC_PORT=3000
LUTIC_INSTANCE_ID=
AUTH_SECRET=
AUTH_SECRET_PREVIOUS=
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=
DATA_RETENTION_DAYS=90
COOKIE_SECURE=true
CORS_ORIGINS=

# Supply the HTTPS issuer URL, issued key, and shared signing secret when enforcing licenses.
LICENSE_ENFORCE=true
LUTIC_LICENSE_KEY=
LICENSE_SERVER_URL=
LICENSE_SIGNING_SECRET=

# Optional runtime integrations & Lutic AI Gateway (LiteLLM)
CLAMAV_HOST=
CLAMAV_PORT=3310
LLM_PROVIDER=lutic
LLM_MODEL=lutic-claude
LUTIC_AI_GATEWAY_URL=http://litellm:4000/v1
LUTIC_AI_GATEWAY_KEY=
LITELLM_MASTER_KEY=
LITELLM_PORT=4000
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_PROVIDER=local

# Optional Clerk Free Tier Auth (Email/Password + Google + Microsoft) & lutic.app custom domain
# Production domain CNAMEs: clerk.lutic.app, accounts.lutic.app (configured in Clerk Dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_OAUTH_PROVIDERS=google,microsoft
LUTIC_DEPLOYMENT_PLAN=free
LUTIC_CLERK_ONLY=false

# Cloudflare Free Tier Tunnel & Origin Isolation (Oracle Cloud Free Tier)
CLOUDFLARE_TUNNEL_TOKEN=
LUTIC_ORIGIN_LOCK_SECRET=
LUTIC_TRUST_CLOUDFLARE_PROXY=true
