# Generate a private copy with bash deploy/kojo.sh prepare.
POSTGRES_USER=kojo
POSTGRES_DB=kojo
POSTGRES_PASSWORD=
DATABASE_URL=
POSTGRES_PORT=5432
KOJO_PORT=3000
KOJO_INSTANCE_ID=
AUTH_SECRET=
AUTH_SECRET_PREVIOUS=
CREDENTIAL_ENCRYPTION_KEY=
