# Database (leave pglite:// for zero-dependency embedded Postgres 16 + pgvector,
# or point to Docker Postgres: postgresql://lutic:lutic_dev_password@localhost:5432/lutic)
DATABASE_URL="pglite://.data/pglite"
POSTGRES_USER="lutic"
POSTGRES_PASSWORD="lutic_dev_password"
POSTGRES_DB="lutic"
POSTGRES_PORT="5432"

# Auth & Cryptography (replace with strong random 32+ byte keys in production)
AUTH_SECRET="dev-auth-secret-change-in-production-32chars"
CREDENTIAL_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# LLM & Embeddings ("mock" runs offline deterministically; "lutic" routes via LiteLLM / Lutic AI Gateway; "anthropic" or "openai" use direct APIs)
LLM_PROVIDER="mock"
LLM_MODEL=""
# Self-hosted LiteLLM gateway settings (uncomment when using LLM_PROVIDER="lutic")
# LUTIC_AI_GATEWAY_URL="http://127.0.0.1:4000/v1"
# LUTIC_AI_GATEWAY_KEY=""
# LITELLM_MASTER_KEY=""
# LITELLM_PORT="4000"
# Deterministic local vectors with full-text search; external embeddings are not implemented.
EMBEDDING_PROVIDER="local"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Runtime / Security
NODE_ENV="development"
LOG_LEVEL="info"
DATA_RETENTION_DAYS="90"
MAX_UPLOAD_BYTES="10485760"
