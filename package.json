{
  "name": "lutic",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @lutic/web dev",
    "build": "bun --filter @lutic/core build && bun --filter @lutic/connectors build && bun --filter @lutic/agent build && bun --filter @lutic/web build",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "bun --filter '*' lint",
    "test": "vitest run",
    "db:migrate": "bun --filter @lutic/core db:migrate",
    "db:bootstrap": "bun --filter @lutic/core db:bootstrap",
    "db:seed": "bun --filter @lutic/core db:seed",
    "sim": "bun --filter @lutic/core sim"
  },
  "overrides": {
    "postcss": "8.5.33",
    "decode-uri-component": "0.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.3",
    "vitest": "4.1.12"
  }
}
